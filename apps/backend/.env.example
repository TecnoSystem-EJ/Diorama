PORT=3001
DATABASE_URL=postgresql://diorama_admin:diorama_password@localhost:5432/diorama_db
# Gere um segredo aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
ENABLE_BACKUP=false
# Credenciais para criar o primeiro administrador local (admin:create não altera usuários existentes).
ADMIN_EMAIL=admin@diorama.local
# Opcional: se vazia, admin:create gera e mostra uma senha aleatória.
ADMIN_PASSWORD=
# Necessárias somente quando ENABLE_BACKUP=true:
CONTAINER_NAME=diorama_db
DB_NAME=diorama_db
DB_USER=diorama_admin
DB_PASSWORD=diorama_password
