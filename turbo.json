{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "PORT",
    "WEB_ORIGIN",
    "PUBLIC_API_URL",
    "ENABLE_BACKUP",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": [
        "db:generate"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "backend#build": {
      "outputs": []
    }
  }
}
