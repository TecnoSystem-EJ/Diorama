{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_INTERNAL_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "PORT",
    "WEB_ORIGIN",
    "PUBLIC_API_URL",
    "ENABLE_BACKUP",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_CONTACT_EMAIL",
    "NEXT_PUBLIC_INSTAGRAM_URL",
    "NEXT_PUBLIC_SPOTIFY_URL",
    "NEXT_PUBLIC_ISSN",
    "UPLOAD_DIR",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "NEWSLETTER_FROM",
    "NEWSLETTER_PUBLIC_URL",
    "BACKUP_DIR",
    "BACKUP_USE_DOCKER",
    "BACKUP_SCHEDULE",
    "BACKUP_TIMEZONE",
    "BACKUP_COMPOSE_FILE"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": [
        "db:generate"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "backend#build": {
      "outputs": []
    }
  }
}
