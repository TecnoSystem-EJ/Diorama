PORT=3001
DATABASE_URL=postgresql://diorama_admin:diorama_password@localhost:5432/diorama_db
# Gere um segredo aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
ENABLE_BACKUP=false
# Credenciais para criar o primeiro administrador local (admin:create não altera usuários existentes).
ADMIN_EMAIL=admin@diorama.local
# Opcional: se vazia, admin:create gera e mostra uma senha aleatória.
ADMIN_PASSWORD=
# Backup: usa DATABASE_URL e inclui banco + uploads. Horário de São Paulo.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_TIMEZONE=America/Sao_Paulo
# No host local sem pg_dump instalado: BACKUP_USE_DOCKER=true
BACKUP_USE_DOCKER=false
# UPLOAD_DIR e BACKUP_DIR opcionais; em produção use volumes persistentes.

# SMTP: no desenvolvimento, docker compose --profile mail up -d mailpit
# não envia e-mails externos. Na produção, configure o provedor real.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NEWSLETTER_FROM=
NEWSLETTER_PUBLIC_URL=http://localhost:3000
